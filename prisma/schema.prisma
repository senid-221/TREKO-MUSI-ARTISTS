generator client { provider = "prisma-client-js" }
datasource db { provider = "postgresql" url = env("DATABASE_URL") }

enum MembershipStatus { PENDING ACTIVE EXPIRED CANCELLED }
enum PromotionStatus { PENDING APPROVED RUNNING COMPLETED REJECTED }
enum PaymentStatus { PENDING PAID FAILED REFUNDED }
enum UserRole { ARTIST ADMIN }

model Artist {
  id String @id @default(cuid())
  stageName String
  fullName String
  email String @unique
  passwordHash String
  phone String?
  genre String?
  bio String?
  avatarUrl String?
  role UserRole @default(ARTIST)
  membershipPlan String @default("Artist")
  membershipStatus MembershipStatus @default(PENDING)
  membershipExpiresAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  payments Payment[]
  releases Release[]
  promotions PromotionRequest[]
  posts CommunityPost[]
  comments CommunityComment[]
  likes CommunityLike[]
}

model Payment {
  id String @id @default(cuid())
  artistId String
  artist Artist @relation(fields:[artistId], references:[id], onDelete:Cascade)
  amount Int
  currency String @default("RWF")
  provider String
  phone String?
  reference String?
  externalTransactionId String?
  status PaymentStatus @default(PENDING)
  createdAt DateTime @default(now())
  verifiedAt DateTime?
}

model Release {
  id String @id @default(cuid())
  artistId String
  artist Artist @relation(fields:[artistId], references:[id], onDelete:Cascade)
  title String
  type String
  artworkUrl String?
  musicUrl String?
  releasedAt DateTime?
  createdAt DateTime @default(now())
}

model PromotionRequest {
  id String @id @default(cuid())
  artistId String
  artist Artist @relation(fields:[artistId], references:[id], onDelete:Cascade)
  title String
  goal String?
  budget Int?
  targetAudience String?
  platforms String?
  status PromotionStatus @default(PENDING)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CommunityPost {
  id String @id @default(cuid())
  artistId String
  artist Artist @relation(fields:[artistId], references:[id], onDelete:Cascade)
  content String
  createdAt DateTime @default(now())
  comments CommunityComment[]
  likes CommunityLike[]
}

model CommunityComment {
  id String @id @default(cuid())
  postId String
  artistId String
  post CommunityPost @relation(fields:[postId], references:[id], onDelete:Cascade)
  artist Artist @relation(fields:[artistId], references:[id], onDelete:Cascade)
  content String
  createdAt DateTime @default(now())
}

model CommunityLike {
  id String @id @default(cuid())
  postId String
  artistId String
  post CommunityPost @relation(fields:[postId], references:[id], onDelete:Cascade)
  artist Artist @relation(fields:[artistId], references:[id], onDelete:Cascade)
  createdAt DateTime @default(now())
  @@unique([postId, artistId])
}
